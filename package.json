{
  "name": "@chaeco/ip-lookup",
  "version": "0.1.3",
  "description": "A unified IP lookup plugin with rotating public providers and normalized results",
  "keywords": [
    "ip",
    "geoip",
    "lookup",
    "provider",
    "rotation",
    "typescript"
  ],
  "license": "MIT",
  "author": "iptodays",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaeco/ip-lookup.git"
  },
  "bugs": {
    "url": "https://github.com/chaeco/ip-lookup/issues"
  },
  "homepage": "https://github.com/chaeco/ip-lookup#readme",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs -w",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint --cache .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
